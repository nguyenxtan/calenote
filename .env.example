# No credential is required to render the UI.
# Bot tokens are entered in the onboarding form and used once for server-side getMe verification.

# Future production stages will require a public HTTPS origin and managed encryption key.
# CALENOTE_PUBLIC_URL=https://calenote.example.com
# CALENOTE_KMS_KEY_ID=...

# Optional intelligence is OFF when these are absent. Do not commit a real key.
# AI_MODE=off
# OPENROUTER_API_KEY=set-in-Cloudflare-secret-store
# OPENROUTER_FREE_MODEL=openrouter/free
# OPENROUTER_ECONOMY_MODEL=provider/model
# OPENROUTER_FALLBACK_MODELS=provider/fallback-one,provider/fallback-two
# AI_MAX_FALLBACK_ATTEMPTS=1
# AI_MAX_FALLBACK_PRICE=0.01
# AI_TIMEOUT_MS=5000
# AI_MAX_INPUT_CHARS=1800
# AI_MAX_OUTPUT_TOKENS=256
