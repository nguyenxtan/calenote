# No credential is required to render the UI.
# Bot tokens are entered in the onboarding form and used once for server-side getMe verification.

# Future production stages will require a public HTTPS origin and managed encryption key.
# CALENOTE_PUBLIC_URL=https://calenote.example.com
# CALENOTE_KMS_KEY_ID=...

# Local development must not inherit production AI authority.
AI_MODE=off
# Production non-secret values are canonical in wrangler.jsonc, not this file.
# Production secret NAME: OPENROUTER_API_KEY (install securely only after Task 6 approval).
# Never place a real key in this example, source, config, logs, or local smoke tests.
# Semantic V1 uses only google/gemini-2.5-flash-lite / google-vertex/eu with ZDR.
# AI_MODE=free is unavailable; no economy mode or model/provider fallback exists.
