{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calenote",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "calenote.iconiclogs.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ORIGIN": "https://calenote.iconiclogs.com",
    "CALENOTE_RUNTIME_ENVIRONMENT": "production",
    "AI_MODE": "privacy",
    "OPENROUTER_PRIVACY_MODEL": "google/gemini-2.5-flash-lite",
    "OPENROUTER_PRIVACY_PROVIDER": "google-vertex/eu",
    "AI_MAX_PRIVACY_PRICE": "0.4",
    "AI_TIMEOUT_MS": "30000",
    "AI_MAX_INPUT_CHARS": "1800",
    "AI_MAX_OUTPUT_TOKENS": "256",
    "OWNER_DAILY_CALL_LIMIT": "50",
    "OWNER_MONTHLY_COST_MICROUNITS": "500000",
    "GLOBAL_DAILY_COST_MICROUNITS": "2000000"
  },
  "secrets": {
    "required": ["CALENOTE_MASTER_KEY", "OPENROUTER_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calenote-production",
      "database_id": "c11403c7-1ce6-4254-8b83-f7066d93fb5f",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "calenote-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "calenote-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "calenote-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"]
  }
}
